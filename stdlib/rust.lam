// Stdlib: Rust / Cargo image helpers.
// Import with: use "std/rust.lam";
//
// Cache mounts intentionally omit `registry/src`. Sharing that tree across
// concurrent `cargo` invocations races on unpack (`.cargo-ok: File exists`).
// Give each parallel build stage its own target cache id via `cargo_build_mounts`.
//
// Multi-step shell prefers `.run([…])` / `.run_with([…], mounts)` (joined with
// newlines) plus `set -eux` — not `"a && b && c"` strings.

/// Official `rust` image (`rust:1.80`, `rust:1.80-bookworm`, `rust:1-alpine`, …).
pub fn from_version(version: String) -> Stage {
  Stage.from("rust:" + version)
}

/// Shared Cargo registry index/cache + git db mounts (safe to share across stages).
pub fn cargo_registry_mounts() -> List[Mount] {
  [
    Mount.cache("/usr/local/cargo/registry/index", "cargo-registry-index"),
    Mount.cache("/usr/local/cargo/registry/cache", "cargo-registry-cache"),
    Mount.cache("/usr/local/cargo/git/db", "cargo-git-db")
  ]
}

/// Registry caches plus a **per-stage** `target/` cache (`target_id` must be unique
/// if stages build concurrently, e.g. `"cargo-target-backend"`).
pub fn cargo_build_mounts(target_id: String) -> List[Mount] {
  cargo_registry_mounts() + [
    Mount.cache("/src/target", target_id)
  ]
}

/// Default workspace layout under `/src`.
pub fn with_workspace(s: Stage) -> Stage {
  s.workdir("/src")
}

/// Copy the whole context then `cargo build -r --bin <bin>` → `/out/<bin>` with caches.
/// Prefer bind mounts in app `.lam` files when the monorepo is large (see USER_GUIDE).
pub fn build_release_bin(s: Stage, bin: String) -> Stage {
  s.copy(".", ".")
    .run_with(
      [
        "set -eux",
        "mkdir -p /out",
        "cargo build -r --bin " + bin,
        "cp target/release/" + bin + " /out/" + bin
      ],
      cargo_build_mounts("cargo-target-" + bin)
    )
}

/// Static musl binary: `x86_64-unknown-linux-musl` → `/out/<bin>`.
/// Call `with_musl_tools` + `rustup_target(..., "x86_64-unknown-linux-musl")` on the toolchain stage first.
pub fn build_release_musl(s: Stage, bin: String) -> Stage {
  s.copy(".", ".")
    .run_with(
      [
        "set -eux",
        "mkdir -p /out",
        "cargo build -r --bin " + bin + " --target=x86_64-unknown-linux-musl",
        "cp target/x86_64-unknown-linux-musl/release/" + bin + " /out/" + bin
      ],
      cargo_build_mounts("cargo-target-musl-" + bin)
    )
}

/// Debian/Ubuntu builder: musl-tools for static linking (no-op useful on alpine rust images).
pub fn with_musl_tools(s: Stage) -> Stage {
  s.run([
    "set -eux",
    "apt-get update",
    "apt-get install -y --no-install-recommends musl-tools musl-dev",
    "rm -rf /var/lib/apt/lists/*"
  ])
}

/// `rustup target add <triple>` (e.g. `wasm32-unknown-unknown`, `x86_64-unknown-linux-musl`).
pub fn rustup_target(s: Stage, triple: String) -> Stage {
  s.run("rustup target add " + triple)
}
